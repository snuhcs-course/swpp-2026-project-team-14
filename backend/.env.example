# Copy to backend/.env. Existing environment variables take precedence.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_SECRET_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Leave DATABASE empty to run body analysis and landmarks without a database.
# To enable wardrobe persistence, fill in an existing MySQL database and account.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
GEMINI_API_KEY=
# Defaults: backend/wardrobe/garment-landmarks and backend/private/wardrobe-media
# WARDROBE_MODEL_DIR=/absolute/path/to/garment-landmarks
# WARDROBE_MEDIA_ROOT=/absolute/path/to/wardrobe-media
